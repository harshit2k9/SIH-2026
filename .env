# PostgreSQL Configuration
POSTGRES_USER=sddms_user
POSTGRES_PASSWORD=sddms_secure_password_2025
POSTGRES_DB=sddms_db

# MinIO Configuration (S3-compatible storage)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secure_password_2025
MINIO_BUCKET=legal-documents
MINIO_USE_SSL=false
MINIO_ENABLE_SSE=true

# ClamAV Configuration
CLAMAV_PORT=3310
ENABLE_AV_SCAN=false

# JWT Configuration
JWT_PRIVATE_KEY_PATH=/app/keys/private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem
JWT_AUDIENCE=sddms-api
JWT_ISSUER=sddms-auth-service

# Application Configuration
SIH26_SESSION_SECRET=super_secret_session_key_2025_change_in_production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,https://*.app.github.dev
MAX_FILE_SIZE_BYTES=2048576000
ENVIRONMENT=development

# Database Connection (for local development without Docker)
DATABASE_URL=postgresql://sddms_user:sddms_secure_password_2025@localhost:5432/sddms_db
