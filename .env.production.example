# Production Environment Variables
# Copy this to .env.production and update values
# NEVER commit .env.production to version control!

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# For production, use an external database service like:
# - Neon.tech (free serverless PostgreSQL)
# - Supabase (free 500MB)
# - Render PostgreSQL (90 days free)
POSTGRES_USER=sddms_user
POSTGRES_PASSWORD=CHANGE_THIS_IN_PRODUCTION_strong_password_here
POSTGRES_DB=sddms_db

# Full connection string for external databases
# Example: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname
DATABASE_URL=postgresql://sddms_user:CHANGE_THIS_IN_PRODUCTION@localhost:5432/sddms_db

# ===========================================
# JWT CONFIGURATION
# ===========================================
# Generate new keys for production (see DEPLOYMENT_PRODUCTION.md)
JWT_PRIVATE_KEY_PATH=/app/keys/private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem
JWT_AUDIENCE=sddms-api
JWT_ISSUER=sddms-auth-service

# ===========================================
# SECURITY SETTINGS
# ===========================================
# Generate a strong random secret (64+ characters)
# Use: openssl rand -hex 32
SIH26_SESSION_SECRET=CHANGE_THIS_IN_PRODUCTION_generate_random_64_char_secret_here

# Update with your actual domain(s)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://your-app.vercel.app

# ===========================================
# MINIO / FILE STORAGE
# ===========================================
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=CHANGE_THIS_IN_PRODUCTION_strong_minio_password
MINIO_BUCKET=legal-documents
MINIO_USE_SSL=true
MINIO_ENABLE_SSE=true

# For external storage services:
# Cloudinary: https://cloudinary.com (free 25GB)
# Backblaze B2: https://backblaze.com (free 10GB)
# MINIO_ENDPOINT_URL=https://your-cloudinary-or-backblaze-url

# ===========================================
# CLAMAV ANTIVIRUS
# ===========================================
CLAMAV_PORT=3310
# Disable for free tier deployments to save resources
ENABLE_AV_SCAN=false

# ===========================================
# APPLICATION SETTINGS
# ===========================================
MAX_FILE_SIZE_BYTES=2048576000
ENVIRONMENT=production

# ===========================================
# FRONTEND API URL
# ===========================================
# For Docker deployment (internal network)
VITE_API_URL=http://backend:8000

# For separate deployments (update with your backend URL)
# VITE_API_URL=https://api.yourdomain.com
# VITE_API_URL=https://your-backend.onrender.com
